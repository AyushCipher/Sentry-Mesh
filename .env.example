# SentryMesh configuration
# Copy to .env and fill in.  All data handled by this system is SYNTHETIC.

# ---------------------------------------------------------------------------
# LLM reasoning backend
# ---------------------------------------------------------------------------
# When ANTHROPIC_API_KEY is set, every specialist and the supervisor run a real
# Anthropic tool-use loop.  When it is absent, SentryMesh falls back to the
# offline deterministic reasoner (clearly labelled in every event payload and
# in the harness report as run_mode="offline_deterministic").
ANTHROPIC_API_KEY=
SENTRYMESH_MODEL=claude-sonnet-4-5
SENTRYMESH_MAX_TOKENS=2048

# Force a backend regardless of key presence: "anthropic" | "offline" | "auto"
SENTRYMESH_LLM_BACKEND=auto

# ---------------------------------------------------------------------------
# Shared event log (Redis)
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
# Set to 1 to refuse to start unless a real Redis server answers PING.
SENTRYMESH_REQUIRE_REDIS=0

# ---------------------------------------------------------------------------
# Historical case retrieval (PostgreSQL + pgvector)
# ---------------------------------------------------------------------------
# Optional.  Without a reachable pgvector database the historical-case agent
# uses the bundled in-process cosine-similarity index over the same corpus.
DATABASE_URL=postgresql://sentrymesh:sentrymesh@localhost:5432/sentrymesh
SENTRYMESH_REQUIRE_PGVECTOR=0

# ---------------------------------------------------------------------------
# Decision thresholds (see sentrymesh/config.py for semantics)
# ---------------------------------------------------------------------------
SENTRYMESH_AUTO_DECLINE_RISK=70
SENTRYMESH_AUTO_APPROVE_RISK=35
SENTRYMESH_MIN_CONFIDENCE=0.70
