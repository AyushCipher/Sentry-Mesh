# SentryMesh configuration
# Copy to .env and fill in.  All data handled by this system is SYNTHETIC.

# ---------------------------------------------------------------------------
# LLM reasoning backend  -  pick ONE of the three options below
# ---------------------------------------------------------------------------
# With none of them configured, SentryMesh runs the offline deterministic
# reasoner: real tools, real event log, but judgement from an explicit scoring
# function rather than a model.  It is labelled in every event payload and in
# the harness report as run_mode="offline_deterministic".
#
# Force a backend regardless of what is set:
#   "anthropic" | "openai_compat" | "offline" | "auto"  (auto = infer, default)
SENTRYMESH_LLM_BACKEND=auto
SENTRYMESH_MAX_TOKENS=2048

# --- Option 1: any OpenAI-compatible provider (free tiers available) --------
# "OpenAI-compatible" is a REQUEST FORMAT, not the company.  None of the
# providers below is OpenAI and none needs an OpenAI key - they simply accept
# the same request shape, so one adapter serves all of them and switching
# provider is an edit to these two lines.
#
#   Groq          free key at https://console.groq.com  (fast; recommended)
SENTRYMESH_LLM_BASE_URL=https://api.groq.com/openai/v1
SENTRYMESH_LLM_API_KEY=
SENTRYMESH_MODEL=llama-3.3-70b-versatile
#
#   Google Gemini  free key at https://aistudio.google.com
# SENTRYMESH_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# SENTRYMESH_LLM_API_KEY=AIza...
# SENTRYMESH_MODEL=gemini-2.0-flash
#
#   GitHub Models  free with any GitHub account
# SENTRYMESH_LLM_BASE_URL=https://models.inference.ai.azure.com
# SENTRYMESH_LLM_API_KEY=ghp_...
# SENTRYMESH_MODEL=gpt-4o-mini
#
#   Ollama         fully local, no key, no account
# SENTRYMESH_LLM_BASE_URL=http://localhost:11434/v1
# SENTRYMESH_LLM_API_KEY=not-required
# SENTRYMESH_MODEL=qwen2.5:14b
#
# NOTE: every specialist ends its turn by calling a `submit_finding` tool, so
# the model you choose MUST support tool/function calling.  Models that do not
# will fail with error_class="agent_protocol_error" - which the harness reports
# separately from wrong verdicts, so a bad model choice is visible rather than
# silently degrading the numbers.

# --- Option 2: Anthropic ----------------------------------------------------
# Roughly $1 per full 23-case harness run on claude-haiku-4-5.
# ANTHROPIC_API_KEY=
# SENTRYMESH_MODEL=claude-haiku-4-5

# --- Option 3: nothing ------------------------------------------------------
# Leave everything above unset for the offline deterministic reasoner.

# ---------------------------------------------------------------------------
# Shared event log (Redis)
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
# Redis is REQUIRED by default (fail-closed): without it the audit log would silently be
# in-memory. For a laptop run without Redis set SENTRYMESH_DEV=1 (allows the labelled
# in-memory fallback), or set SENTRYMESH_REQUIRE_REDIS=0 explicitly. An explicit
# SENTRYMESH_REQUIRE_REDIS always wins over SENTRYMESH_DEV.
SENTRYMESH_DEV=1
# SENTRYMESH_REQUIRE_REDIS=1
# Optional cap on the shared stream length (XADD MAXLEN ~). 0 = unbounded.
# SENTRYMESH_STREAM_MAXLEN=0

# API: comma-separated browser origins (default: local Vite dev server) and an optional
# shared secret; when set, review-queue POSTs need an X-API-Key header.
# SENTRYMESH_CORS_ORIGINS=http://localhost:5173
# SENTRYMESH_API_KEY=

# Supervisor-LLM bounding policy (see bound_model_assessment).
# SENTRYMESH_RISK_FLOOR_FACTOR=0.9
# SENTRYMESH_MAX_MODEL_RISK_DIVERGENCE=30

# ---------------------------------------------------------------------------
# Historical case retrieval (PostgreSQL + pgvector)
# ---------------------------------------------------------------------------
# Optional.  Without a reachable pgvector database the historical-case agent
# uses the bundled in-process cosine-similarity index over the same corpus.
DATABASE_URL=postgresql://sentrymesh:sentrymesh@localhost:5432/sentrymesh
SENTRYMESH_REQUIRE_PGVECTOR=0

# ---------------------------------------------------------------------------
# Decision thresholds (see sentrymesh/config.py for semantics)
# ---------------------------------------------------------------------------
SENTRYMESH_AUTO_DECLINE_RISK=70
SENTRYMESH_AUTO_APPROVE_RISK=35
SENTRYMESH_MIN_CONFIDENCE=0.70
